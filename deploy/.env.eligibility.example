# Eligibility issuer env — the eligibility service is a SEPARATE operator concern, so it
# has its own env file (not the admin/operator stack's deploy/.env). Copy to
# deploy/.env.eligibility and fill in, or let `python scripts/gen_deploy_env.py` generate a
# coherent one (its public key wired into sample-election.json's eligibility_key).
#
# Run:  docker compose -f deploy/docker-compose.eligibility.yml \
#         --env-file deploy/.env.eligibility up -d --build
#
# PRODUCTION: this stub is plain HTTP. A real issuer is public + browser-facing — put it
# behind TLS + DNS and a reverse proxy (Caddy/nginx) with rate-limiting on /attest.

# Issuing secp256k1 key (0x-hex). Its public key MUST equal each election config's
# eligibility_key, or every ballot fails attestation verification at admission.
ELIGIBILITY_PRIVATE_KEY=0x<64 hex>

# Listen + published port (default 8600).
ELIGIBILITY_PORT=8600

# Default voting weight granted to an eligible wallet (dummy issuer). A real issuer reads
# per-voter weight from its own source of voting power.
ELIGIBILITY_DUMMY_WEIGHT=1

# The public API's base URL (required). The issuer reads each election's config through it:
# an unweighted (one per voter) election is issued weight 1 whatever the allowlist says.
SHUTTER_GOVERNANCE_PROTOCOL_API_URL=http://host.docker.internal:8500

# Optional deny path: point at the mounted allowlist (deploy/eligibility-allowlist.json →
# /app/eligibility-allowlist.json) to gate issuance. Unset = allow all (dummy default).
# ELIGIBILITY_ALLOWLIST=/app/eligibility-allowlist.json

# Optional HMAC secret keying the private pseudonym (hex). Unset = derived from the issuing
# key (fine for dev).
# ELIGIBILITY_PSEUDONYM_SECRET=<hex>
